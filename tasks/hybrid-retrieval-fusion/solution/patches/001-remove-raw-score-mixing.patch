# Patch 001 - remove raw-score mixing
# Fuse on reciprocal RANKS, not raw modality scores. Adding raw BM25 scores to
# cosine similarities lets one modality scale dominate and violates the RRF
# contract. Restore contribution = 1/(rrf_k + rank).

diff --git a/hybrid_search/fusion.py b/hybrid_search/fusion.py
index 0f16b05..ac41382 100644
--- a/hybrid_search/fusion.py
+++ b/hybrid_search/fusion.py
@@ -59,8 +59,6 @@ def _index(ranking: Sequence[RankingEntry]) -> Tuple[Dict[str, int], Dict[str, R
 
 
 def _contribution(rrf_k: int, rank: int, entry: RankingEntry) -> float:
-    if _hook("RAW_MIXING"):
-        return entry.raw_score
     if _hook("RANK_BASE"):
         return 1.0 / (rrf_k + (rank - 1))
     return 1.0 / (rrf_k + rank)
